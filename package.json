{
  "name": "wslog-proxy",
  "version": "0.1.0",
  "description": "Record any WebSocket traffic and watch it live in a browser dashboard. No code changes.",
  "keywords": [
    "websocket",
    "ws",
    "proxy",
    "debugger",
    "devtools",
    "inspector",
    "logger"
  ],
  "license": "MIT",
  "author": "Leangdev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoysengleang/wslog.git"
  },
  "homepage": "https://github.com/hoysengleang/wslog#readme",
  "bugs": {
    "url": "https://github.com/hoysengleang/wslog/issues"
  },
  "type": "module",
  "bin": {
    "wslog": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/cli/index.ts --demo",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:web && playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
